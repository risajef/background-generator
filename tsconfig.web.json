{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "web/dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true
  },
  "include": [
    "ts/lib/**/*.ts",
    "web/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "ts-outputs",
    "outputs"
  ]
}
