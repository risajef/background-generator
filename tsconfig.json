{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true
  },
  "include": [
    "ts/**/*.ts",
    "tests/types.ts"
  ],
  "exclude": [
    "node_modules",
    "web",
    "outputs"
  ]
}
